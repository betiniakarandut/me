{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "/backend/**"
    ]
  },
  "deploy": {
    "preDeployCommand": [
      "sh scripts/predeploy.sh"
    ],
    "healthcheckPath": "/api/v1/health/ready",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
