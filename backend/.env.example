APP_NAME=Betini Personal Website API
API_V1_PREFIX=/api/v1
DEBUG=true

# Default: SQLite (file-based, no separate DB service/cost). Works well on a
# VPS/Coolify deployment with a persistent disk. Avoid ephemeral-filesystem
# hosts (e.g. Render's free web service tier) unless you add a persistent
# disk there too, or the file resets on every redeploy.
DATABASE_URL=sqlite:///./betini_site.db

# Swap to Postgres by commenting the line above and uncommenting this one:
# DATABASE_URL=postgresql+psycopg2://me_user:my_super_secret_password@localhost:5432/me_db

GITHUB_USERNAME=betiniakarandut

# Optional. Unauthenticated GitHub API requests are capped at 60/hour per IP,
# which shared hosting IPs (e.g. Render) can exhaust. A classic PAT with no
# scopes (public read access only) raises this to 5,000/hour. Generate one at
# https://github.com/settings/tokens
GITHUB_TOKEN=

HASHNODE_BLOG_RSS_URL=https://betiniakarandut.hashnode.dev/rss.xml

