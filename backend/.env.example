# Copy to backend/.env for local development. Never commit .env.
# In production (Railway) set these as service variables instead.

APP_NAME=Betini Personal Website API
API_V1_PREFIX=/api/v1
# Keep false in production: true returns tracebacks in error responses.
DEBUG=false

# Local default: SQLite file in backend/. Production: Railway PostgreSQL, set
# as DATABASE_URL=${{Postgres.DATABASE_URL}} (private network).
DATABASE_URL=sqlite:///./betini_site.db
# Local Postgres example:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DBNAME

# Allowed browser origins, comma-separated. Defaults to the local Vite servers
# (localhost:5173 / :4173) when unset. Production:
# CORS_ORIGINS=https://betiniakarandut.com,https://www.betiniakarandut.com
# CORS_ORIGINS=

GITHUB_USERNAME=betiniakarandut
# Optional classic PAT with no scopes: raises the GitHub API limit from 60 to
# 5,000 requests/hour. Used server-side only, never sent to the browser.
GITHUB_TOKEN=

# Contact form email notifications via Resend. Without RESEND_API_KEY the form
# still saves messages to the database but sends no email.
RESEND_API_KEY=
CONTACT_NOTIFICATION_EMAIL=
# onboarding@resend.dev only delivers to the Resend account owner. After
# verifying betiniakarandut.com in Resend, use an address on that domain.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Contact form abuse limits (per rolling window).
# CONTACT_RATE_LIMIT_PER_CLIENT=5
# CONTACT_RATE_LIMIT_GLOBAL=50
# CONTACT_RATE_LIMIT_WINDOW_SECONDS=3600
